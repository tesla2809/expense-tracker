PORT=3000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kushal-timbers-expenses
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Optional: payment due-date reminder emails ---
# Leave these unset and reminders are simply skipped (a warning is logged
# once, nothing crashes). For Gmail: turn on 2-Step Verification, then create
# an "App Password" at https://myaccount.google.com/apppasswords and use that
# as SMTP_PASS (not your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM=youraddress@gmail.com
# How many days before a pending payment's due date to start emailing about it.
REMINDER_DAYS_BEFORE=2

# --- Optional: reliable daily automation on free hosting ---
# Render's free tier sleeps after 15 minutes idle, so the server's own
# internal daily schedule can silently miss a day. Set this to any random
# string, then set up a free scheduled ping (e.g. https://cron-job.org) to
# POST https://<your-render-url>/api/cron/run-daily once a day with a header
# `x-cron-secret: <this same string>` — that guarantees recurring
# transactions and reminder emails run even if the server was asleep.
CRON_SECRET=replace-with-another-random-string
