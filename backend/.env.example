PORT=3000
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Google Sheets is the app's database (there is no MongoDB anymore) ---
# Every user, login and expense row is stored as a row in ONE Google Sheet.
# You need BOTH variables below for the app to work at all — without them,
# the server starts but nothing can be saved.
#
# Setup (one-time, in Google Cloud Console — console.cloud.google.com):
#   1. Create a project (or reuse one) and enable the "Google Sheets API"
#      under APIs & Services > Library.
#   2. APIs & Services > Credentials > Create Credentials > Service Account.
#      Give it any name (e.g. "kushal-timbers-sheets"), no roles needed.
#   3. Open the new service account > Keys > Add Key > Create new key > JSON.
#      This downloads a .json file — open it in a text editor.
#   4. Paste that file's ENTIRE contents below, as one single line (most
#      editors have a "join lines" command, or minify it at jsonformatter.org).
#   5. In the downloaded JSON, find "client_email" (looks like
#      xxx@xxx.iam.gserviceaccount.com).
#   6. In Google Sheets (sheets.google.com), create a new blank spreadsheet —
#      this one becomes the app's database. Rename it something like
#      "Kushal Timbers - App Database" so it's not confused with any other
#      Sheet. Click Share, and share it with the client_email from step 5 as
#      an Editor (untick "Notify people" — it's a robot account, not a person).
#   7. Copy that spreadsheet's ID from its URL:
#      https://docs.google.com/spreadsheets/d/THIS_LONG_ID_HERE/edit
#      and set GOOGLE_SHEET_ID to it below.
#
# The app will automatically create "Users" and "Expenses" tabs (with
# headers) inside that spreadsheet the first time it starts up. You (or sir)
# can open the spreadsheet at any time to look at the data directly — just
# avoid editing the "id" column or deleting the header row, since the app
# uses those to find rows.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
GOOGLE_SHEET_ID=paste-the-spreadsheet-id-from-step-7-here

# The "Export to Sheet" / "Import from Sheet" buttons in the Expense Sheet
# page are a SEPARATE feature — they push a copy to, or pull rows from, any
# OTHER Google Sheet you paste a link for (for sharing a copy with someone,
# or bulk-importing an existing sheet). They reuse the same
# GOOGLE_SERVICE_ACCOUNT_KEY above; each target Sheet just needs to be
# shared with that same service account email as an Editor too.

# --- "Forgot password" emails (free — uses your own Gmail account, no paid
# email service needed) ---
# Without these two set, the app still works fine — the "forgot password"
# form will just show "email isn't configured" instead of sending a link.
#
# Setup (one-time, takes ~2 minutes):
#   1. Turn on 2-Step Verification on the Gmail account you want to send
#      from (myaccount.google.com/security) — required before Google will
#      let you create an "app password".
#   2. Go to myaccount.google.com/apppasswords, sign in, create a new app
#      password (name it anything, e.g. "Kushal Timbers Tracker"). Google
#      shows you a 16-character password — copy it (no spaces needed).
#   3. Set EMAIL_USER to that Gmail address, and EMAIL_APP_PASSWORD to the
#      16-character app password (NOT your normal Gmail password — that
#      won't work here).
# These two ALSO power "Share Sheet > Email it" on the Expense Sheet page,
# which emails the whole sheet as a spreadsheet attachment to any address.
# Without them, both password reset and sheet-emailing are unavailable.
EMAIL_USER=youraccount@gmail.com
EMAIL_APP_PASSWORD=paste-the-16-character-app-password-here

# The reset link emailed to users points back at your live frontend, e.g.
# https://kushal-timbers-expense-tracker.vercel.app (no trailing slash).
# Use http://localhost:5173 for local testing.
FRONTEND_URL=https://kushal-timbers-expense-tracker.vercel.app

# --- Permanent storage for uploaded bills and vehicle documents (free) ---
# IMPORTANT: without these three, uploaded files fall back to the server's
# own disk — and on Render's free tier that disk is WIPED on every redeploy
# and every time the service spins down after inactivity. Files uploaded
# that way WILL eventually vanish. Set these to keep them permanently.
#
# (Google Drive can't be used for this, even though the app already has a
# Google service account: service accounts have zero Drive storage quota of
# their own, and uploading into a shared folder still bills the service
# account rather than the folder's owner. The official workarounds need paid
# Google Workspace.)
#
# Setup (one-time, ~2 minutes, no credit card):
#   1. Sign up free at cloudinary.com.
#   2. On the dashboard you land on, find "Product Environment Credentials"
#      — it shows Cloud Name, API Key and API Secret.
#   3. Copy those three values into the variables below.
#
# The free plan gives 25 monthly credits (1 credit = 1GB storage or 1GB of
# viewing bandwidth). Bills are a few hundred KB each, so this is years of
# headroom. The app uploads originals only — it never runs image
# transformations, which is the thing that normally burns through credits.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
